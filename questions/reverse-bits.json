{
  "schema_version": "1.0",
  "id": "reverse-bits",
  "version": 1,
  "title": "Reverse a 32-bit peripheral bit sequence",
  "description": "Reverse exactly 32 bits of an unsigned value.",
  "type": "coding",
  "difficulty": "intermediate",
  "topics": [
    "bit operations",
    "registers",
    "embedded C"
  ],
  "duration_minutes": 30,
  "language": "c",
  "prompt": "Reverse exactly 32 bits of an unsigned value.\nImplement uint32_t reverse_bits(uint32_t value). Bit i of the input becomes bit 31-i of the result.",
  "constraints": [
    "Every uint32_t value is valid.",
    "No target-specific instructions or compiler intrinsics.",
    "Single-threaded, no hardware access or allocation. Byte order in memory does not change the numeric contract."
  ],
  "starter_files": {
    "exercise.h": "#include <stdint.h>\nuint32_t reverse_bits(uint32_t value);\n",
    "exercise.c": "#include \"exercise.h\"\n/* Implement the declared function. */\n"
  },
  "reference_solution": {
    "exercise.h": "#include <stdint.h>\nuint32_t reverse_bits(uint32_t value);\n",
    "exercise.c": "#include \"exercise.h\"\nuint32_t reverse_bits(uint32_t value) {\n uint32_t result=0;\n for(unsigned i=0;i<32;i++) {result=(result<<1)|(value&1u);value>>=1;}\n return result;\n}\n"
  },
