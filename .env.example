# Server-side settings only. Never put credentials in VITE_* variables.
FORGEPAD_DB=data/forgepad.sqlite3
FORGEPAD_RUNNER_IMAGE=forgepad-runner:local
# Set this only if your runtime requires a non-default context:
# DOCKER_CONTEXT=colima-forgepad
# FORGEPAD_RUNNER_TMPDIR=/absolute/path/shared/with/docker

# Optional local provider configuration is documented in docs/providers.md.
# ForgePad does not require a paid API key.

# Hosted deployment only; configure through Vercel server environment settings.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-value
# FORGEPAD_HOST=your-assigned-host.vercel.app
# FORGEPAD_RUNNER_URL=https://your-assigned-host.vercel.app/api/runner
# FORGEPAD_RUNNER_SECRET=server-only-random-value
