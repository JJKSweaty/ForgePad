{
  "name": "forgepad",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --prefix frontend",
    "desktop:dev": "tauri dev",
    "desktop:build": "python3 scripts/prepare_native.py && tauri build --bundles app && python3 scripts/sign_local_bundle.py",
    "desktop:install": "npm run desktop:build && python3 scripts/install_local.py",
    "native:check": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "native:prepare": "python3 scripts/prepare_native.py",
    "speech:prepare": "python3 scripts/prepare_speech.py"
  },
  "dependencies": {
    "@vercel/sandbox": "3.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "prettier": "^3.9.10"
  },
  "version": "0.3.6"
}
