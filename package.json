    "native:prepare": "python3 scripts/prepare_native.py"
  },
  "dependencies": {
    "@vercel/sandbox": "3.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "prettier": "^3.9.10"
  }
}
